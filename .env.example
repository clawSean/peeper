# Copy to .env for local auto-like runs. Do not commit real secrets.

# dry-run records what would happen. live performs public X likes.
PEEPER_MODE=dry-run

# Live mode requires this exact acknowledgement too:
# PEEPER_LIVE_ACK=I_UNDERSTAND_THIS_LIKES_FROM_MY_X_ACCOUNT

# xurl settings. Peeper reads posts without xurl; xurl is used only for likes.
PEEPER_XURL_BIN=xurl
PEEPER_XURL_WRITE_APP=your-oauth2-app
PEEPER_XURL_WRITE_AUTH=oauth2
PEEPER_LIKER_USER_ID=123456789

# Optional local guardrail label for docs/logs.
PEEPER_EXPECTED_LIKER_USERNAME=yourusername
